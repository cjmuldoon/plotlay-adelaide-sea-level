	partition Levels = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/levels.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"kind", "level_m_ahd", "label", "land_ha", "mean_depth_m", "max_depth_m", "addresses", "residential_addresses", "residents_2021", "dwellings_2021"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"kind", type text}, {"level_m_ahd", type number}, {"label", type text}, {"land_ha", Int64.Type}, {"mean_depth_m", type number}, {"max_depth_m", type number}, {"addresses", Int64.Type}, {"residential_addresses", Int64.Type}, {"residents_2021", Int64.Type}, {"dwellings_2021", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
