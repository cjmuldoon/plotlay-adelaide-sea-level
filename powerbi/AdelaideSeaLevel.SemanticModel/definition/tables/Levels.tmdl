table Levels
	lineageTag: 91aedca0-0492-a5fb-a2c2-82abec5626f3

	/// Land (ground above 0 m AHD) below the level and reachable from the sea
	measure 'Land under water (ha)' = CALCULATE ( SUM ( Levels[land_ha] ), Levels[kind] = "grounded" )
		formatString: #,0
		lineageTag: 12c5a8af-67d9-22a9-e49f-02b1798feba3

	/// G-NAF principal addresses in ABS Residential mesh blocks whose ground is below the level
	measure 'Residential addresses below' = CALCULATE ( SUM ( Levels[residential_addresses] ), Levels[kind] = "grounded" )
		formatString: #,0
		lineageTag: 124b831e-5c6f-81a2-4e8d-365476ad52a3

	/// 2021 Census residents of each mesh block, shared by the part of its ground below the level
	measure 'Residents below' = SUM ( Levels[residents_2021] )
		formatString: #,0
		lineageTag: 156ca6bd-dca2-df4a-d6b8-9e876a72b7a9

