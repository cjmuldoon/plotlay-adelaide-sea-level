table Suburbs
	lineageTag: 78368984-6814-5f0f-0156-58f4d5dfe55e

	measure 'Residential addresses' = SUM ( Suburbs[residential_addresses] )
		formatString: #,0
		lineageTag: abcf5233-6466-113a-229e-9673d26b12b3

	/// Residential addresses below 2.4 m AHD (highest tide + 1.0 m)
	measure 'Below 2.4 m' = SUM ( Suburbs[under_2_4m_ahd] )
		formatString: #,0
		lineageTag: 9cb0f655-2c0b-a8bc-b802-dfbf9931cd93

	/// Residential addresses below 3.4 m AHD (1-in-100-year storm tide + 1.0 m)
	measure 'Below 3.4 m' = SUM ( Suburbs[under_3_4m_ahd] )
		formatString: #,0
		lineageTag: e0939bbc-21dd-5770-92eb-95a0a7747a7b

	measure 'Share below 2.4 m' = DIVIDE ( [Below 2.4 m], [Residential addresses] )
		formatString: 0%
		lineageTag: 7f4d869a-fb21-e8b4-3757-4007c7292406

