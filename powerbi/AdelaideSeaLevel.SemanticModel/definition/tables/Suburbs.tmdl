	partition Suburbs = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/suburbs.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"sal_code", "suburb", "residential_addresses", "under_1_4m_ahd", "under_1_7m_ahd", "under_2_4m_ahd", "under_2_7m_ahd", "under_3_4m_ahd"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"sal_code", type text}, {"suburb", type text}, {"residential_addresses", Int64.Type}, {"under_1_4m_ahd", Int64.Type}, {"under_1_7m_ahd", Int64.Type}, {"under_2_4m_ahd", Int64.Type}, {"under_2_7m_ahd", Int64.Type}, {"under_3_4m_ahd", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
